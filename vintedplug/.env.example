# Sekrety pozostają po stronie serwera.
# Lokalnie używaj .dev.vars; wzór znajduje się w .dev.vars.example.
# Teksty: Gemini. Dla darmowych testów wybierz projekt Free Tier w Google AI Studio.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Lokalne usuwanie tła działa bez klucza. Photoroom to opcjonalny tryb (domyślnie wyłączony).
# Uruchom dopiero po sprawdzeniu planu i kredytów w panelu dostawcy.
PHOTOROOM_API_KEY=
IMAGE_AI_ENABLED=false
VP_GUIDE_AUTHOR_EMAIL=

# Abonament vintedplug: 29,90 PLN / mies. Klucze tylko w sekretach serwera.
# Preferowany klucz ograniczony (rk_), osobny dla test/live.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
VP_APP_ORIGIN=
# Stabilny identyfikator uwierzytelnionego właściciela witryny, nie adres e-mail.
VP_BILLING_OWNER_ID=

# Szyfrowanie klucza Stripe dodawanego przez właściciela w panelu.
# Losowe 32 bajty zapisane jako 64 znaki hex. Nie zmieniaj po zapisie klucza.
VP_BILLING_KEYRING_SECRET=

# Samodzielna wersja na własnym koncie Cloudflare.
# Na obecnym hostingu pozostaw sites. Nigdy nie ustawiaj testowego sekretu w produkcji.
VP_AUTH_MODE=sites
BETTER_AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
